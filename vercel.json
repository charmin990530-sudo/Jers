{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/preparar-estatico.mjs",
  "outputDirectory": "frontend/public",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mis-datos",
      "destination": "/index.html"
    },
    {
      "source": "/perfil",
      "destination": "/index.html"
    },
    {
      "source": "/direcciones",
      "destination": "/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/index.html"
    },
    {
      "source": "/mi-perfil",
      "destination": "/index.html"
    },
    {
      "source": "/mis-direcciones",
      "destination": "/index.html"
    },
    {
      "source": "/mi-perfil.html",
      "destination": "/index.html"
    },
    {
      "source": "/mis-direcciones.html",
      "destination": "/index.html"
    },
    {
      "source": "/contacto.html",
      "destination": "/index.html"
    },
    {
      "source": "/tienda",
      "destination": "/index.html"
    },
    {
      "source": "/bienvenida",
      "destination": "/index.html"
    },
    {
      "source": "/bienvenida.html",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/catalogo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/producto/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/carrito",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/pedidos",
      "destination": "/index.html"
    },
    {
      "source": "/looks",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/recuperar",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/maquillaje",
      "destination": "/index.html"
    },
    {
      "source": "/cabello",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; connect-src 'self'; media-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src-attr 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "installCommand": "npm ci --include=dev && npm ci --include=dev --prefix frontend/angular"
}
