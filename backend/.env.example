# ==========================================
# By Jers - Variables de Entorno
# ==========================================
# Copia este archivo a .env y configura los valores
# NUNCA commitees el archivo .env real (secrets reales)

# ==========================================
# SERVIDOR
# ==========================================
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SECRETS_FROM_ENV=false

# ==========================================
# BASE DE DATOS
# ==========================================
# Desarrollo local
MONGODB_URI=mongodb://localhost:27017/by-jers
# Producción (ejemplo MongoDB Atlas):
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/by-jers?retryWrites=true&w=majority

# ==========================================
# AUTENTICACIÓN (JWT)
# ==========================================
# ⚠️ CRÍTICO: Genera un secret seguro para producción:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=by-jers-api
JWT_AUDIENCE=by-jers-store
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=token

# ==========================================
# FRONTEND & CORS
# ==========================================
FRONTEND_URL=http://localhost:3000
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200
API_ORIGIN=http://localhost:3000
SESSION_EXPIRES_IN=1d
REMEMBER_ME_EXPIRES_IN=30d
# Administradores: duración máxima de una hora, sin sesión larga.
ADMIN_SESSION_EXPIRES_IN=1h

# ==========================================
# RATE LIMITING
# ==========================================
# General: 100 requests per 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoints: 5 requests per minute
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX_REQUESTS=5

# En producción: RATE_LIMIT_STORE=redis con rediss://, o RATE_LIMIT_STORE=mongodb.
# En desarrollo se usa memory si no se indica otro almacén.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
# Tiempo maximo de espera al conectar a Redis (ms). Si REDIS_URL no responde,
# evita que el cold start de Vercel quede colgado hasta el timeout de la funcion.
REDIS_CONNECT_TIMEOUT_MS=5000
# Solo si hay un proxy inverso conocido; no usar valores arbitrarios
TRUST_PROXY_HOPS=0

# ==========================================
# COOKIES
# ==========================================
# true solo en producción con HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ==========================================
# WHATSAPP
# ==========================================
WHATSAPP_NUMBER=573114333561

# ==========================================
# ENVÍO
# ==========================================
# Importes ENTEROS en la unidad mínima (peso), no decimales: 15000 son
# $15.000. Se validan al arrancar; un valor no entero o negativo detiene el
# proceso en vez de dejar el envío a 0 en silencio.
#
# freeFrom: subtotal a partir del cual el envío no se cobra.
# cost:     lo que se cobra cuando el subtotal queda por debajo.
SHIPPING_COST=15000
SHIPPING_FREE_FROM=200000

# ==========================================
# IVA
# ==========================================
# Los precios del catálogo son SIN impuestos: el IVA se suma en el servidor al
# crear el pedido, sobre la base imponible (subtotal + envío), y se muestra
# desglosado en el checkout. expectedTotal permite confirmar la cotización;
# el servidor calcula siempre todos los importes.
#
# La tasa va en PUNTOS BÁSICOS (la centésima parte de un porcentaje) porque no
# todas las tarifas son el 19% general: hay productos de la cesta básica al 5% y
# exportaciones al 0%. Un porcentaje entero no podría representarlas.
#   1900 = 19%   ·   500 = 5%   ·   0 = exento
# Rango válido: de 0 a 10000.
TAX_RATE_BP=1900

# ==========================================
# CONTENT SECURITY POLICY (CSP)
# ==========================================
# Habilitar nonces para scripts inline (requiere template engine)
CSP_NONCE_ENABLED=false

# Modo report-only para probar CSP sin bloquear
CSP_REPORT_ONLY=false

# Endpoint para reportar violaciones CSP
CSP_REPORT_URI=/api/csp-report

# ==========================================
# Seed local: requiere contraseñas explícitas y nunca se ejecuta en producción
# Únicamente sobre una base exclusiva de demostración (reemplaza usuarios y catálogo):
# SEED_CONFIRM_RESET=BORRAR_DATOS_DE_PRUEBA
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_USER_EMAIL=cliente@example.com
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# CLOUDINARY (para subida de imágenes - opcional)
# ==========================================
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# ==========================================
# EMAIL (reset de contraseña y contacto)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-app-password
# EMAIL_FROM=By Jers <noreply@byjers.com>
# ==========================================
# SENTRY (monitoreo de errores en producción)
# ==========================================
# Crea una cuenta en sentry.io y configura SENTRY_DSN para capturar errores
# SENTRY_DSN=

# ==========================================
# PRODUCCIÓN EN VERCEL (checklist)
# ==========================================
# En Vercel NO se sube un .env: todo se define en Project > Settings > Env Vars.
# La app se NEGA a arrancar en producción si falta cualquiera de estos valores.
#
# 1) MongoDB Atlas (plan free) -> pegar la URI mongodb+srv:// en MONGODB_URI
# Alternativa sin Redis: RATE_LIMIT_STORE=mongodb usa contadores compartidos con TTL en Atlas.
# Correo desactivado de forma explícita para presentación: EMAIL_ENABLED=false.
# Con ese ajuste no se envían notificaciones ni funciona la recuperación por email.
# 2) Si RATE_LIMIT_STORE=redis: pegar la URI rediss:// en REDIS_URL y REDIS_ENABLED=true
#    (REDIS_ENABLED solo se activa si ademas NODE_ENV=production)
# 3) HOST=0.0.0.0            Vercel no acepta 127.0.0.1
# 4) PORT                    lo inyecta Vercel; no fijarlo
# 5) TRUST_PROXY_HOPS=1      Vercel corre detras de proxy; sin esto el
#                            rate-limit cuenta a todos los usuarios como uno
# 6) SECRETS_FROM_ENV=true   obligatorio: en Vercel no existe archivo .env y
#                            el chequeo de permisos lo exige
# 7) COOKIE_SECURE=true      obligatorio en produccion
# 8) FRONTEND_URL y FRONTEND_ALLOWED_ORIGINS con https:// y el dominio real
#    (deben coincidir con el dominio de Vercel; FRONTEND_URL debe estar
#    incluida en FRONTEND_ALLOWED_ORIGINS)
# 9) API_ORIGIN con https:// y el mismo dominio (arquitectura de un solo dominio)
# 10) SMTP_HOST / SMTP_USER / SMTP_PASS si EMAIL_ENABLED no es false
#
# Generar JWT_SECRET (64+ caracteres, sin palabras de ejemplo):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# MONGO_MAX_POOL_SIZE=5      pool por instancia (opcional, default 5)
