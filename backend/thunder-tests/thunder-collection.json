    {
      "name": "05 Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "method": "POST",
          "url": "{{baseUrl}}/api/orders",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"direccionEnvio\": {\n    \"alias\": \"Casa\",\n    \"nombreCompleto\": \"Cliente Thunder\",\n    \"telefono\": \"3001234567\",\n    \"direccion\": \"Calle 1 #2-3\",\n    \"ciudad\": \"Bogota\",\n    \"departamento\": \"Cundinamarca\"\n  },\n  \"notas\": \"Pedido de prueba\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            },
            {
              "key": "Idempotency-Key",
              "value": "{{claveIdempotencia}}",
              "description": "Repetir la misma clave devuelve el MISMO pedido: es la protección contra el doble clic."
            }
          ],
          "description": "Transaccional: o se descuenta el stock y se crea el pedido, o no pasa nada."
        },
        {
          "name": "Listar mis pedidos",
          "method": "GET",
          "url": "{{baseUrl}}/api/orders"
        },
        {
          "name": "Detalle de pedido",
          "method": "GET",
          "url": "{{baseUrl}}/api/orders/{{id}}",
          "description": "Solo los del usuario autenticado."
        },
        {
          "name": "Cancelar pedido",
          "method": "PATCH",
          "url": "{{baseUrl}}/api/orders/{{id}}/cancelar",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"motivo\": \"Prueba\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "Solo desde pendiente/confirmado y si no está pagado. Devuelve el stock."
        }
      ]
    },
    {
      "name": "06 Contacto",
