  },
  "auth": {
    "type": "noauth"
  },
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "cliente@byjers.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "ClientePrueba2026!",
      "type": "string"
    },
    {
      "key": "emailRegistro",
      "value": "nuevo@byjers.com",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "claveIdempotencia",
      "value": "thunder-{{$guid}}",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "itemIdAjeno",
      "value": "",
      "type": "string",
      "description": "Un _id de item del carrito de OTRO usuario."
    },
    {
      "key": "idPedidoAjeno",
      "value": "",
      "type": "string",
      "description": "El _id de un pedido de OTRO usuario."
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "item": [
        {
          "name": "Health",
          "method": "GET",
          "url": "{{baseUrl}}/api/health",
          "description": "Estado del proceso, Mongo, Redis y configuración. No requiere sesión. Si Mongo está caído responde 200 con database: \"disconnected\", y las rutas que lo necesitan devuelven 503 DATABASE_UNAVAILABLE.",
          "tests": [
            {
              "type": "res.body.success",
              "operator": "eq",
              "value": true,
              "status": "200 OK"
            }
          ]
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "Obtener token CSRF",
          "method": "GET",
          "url": "{{baseUrl}}/api/auth/csrf",
          "description": "Guarda el valor en la variable {{csrfToken}} de la collection. Es lo que permite las peticiones que mutan."
        },
        {
          "name": "Registro",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/register",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"nombre\": \"Cliente\",\n  \"apellido\": \"Thunder\",\n  \"email\": \"{{emailRegistro}}\",\n  \"password\": \"ClaveSegura123\",\n  \"aceptoTerminos\": true,\n  \"aceptoPrivacidad\": true\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "Deja la cookie de sesión en el cliente de Thunder."
        },
        {
          "name": "Login",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/login",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "Usa {{email}} y {{password}}. Guarda la cookie token."
        },
        {
          "name": "Login · recordar sesión",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/login",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ]
        },
        {
          "name": "Yo",
          "method": "GET",
          "url": "{{baseUrl}}/api/auth/me",
          "description": "Requiere sesión."
        },
        {
          "name": "Actualizar perfil",
          "method": "PATCH",
          "url": "{{baseUrl}}/api/auth/profile",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"nombre\": \"Cliente\",\n  \"telefono\": \"3009999999\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ]
        },
        {
          "name": "Cambiar contraseña",
          "method": "PATCH",
          "url": "{{baseUrl}}/api/auth/password",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"NuevaClave123\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ]
        },
        {
          "name": "Olvidé mi contraseña",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/forgot-password",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"{{email}}\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "Siempre 200, exista o no el email: no enumera usuarios."
        },
        {
          "name": "Restablecer contraseña",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/reset-password",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"token\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"password\": \"NuevaClave123\",\n  \"confirmPassword\": \"NuevaClave123\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ]
        },
        {
          "name": "Alta de dirección",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/addresses",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"alias\": \"Casa\",\n  \"nombreCompleto\": \"Cliente Thunder\",\n  \"telefono\": \"3001234567\",\n  \"direccion\": \"Calle 1 #2-3\",\n  \"ciudad\": \"Bogota\",\n  \"departamento\": \"Cundinamarca\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "La primera dirección queda como principal."
        },
        {
          "name": "Editar dirección",
          "method": "PATCH",
          "url": "{{baseUrl}}/api/auth/addresses/{{addressId}}",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"alias\": \"Oficina\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ]
        },
        {
          "name": "Borrar dirección",
          "method": "DELETE",
          "url": "{{baseUrl}}/api/auth/addresses/{{addressId}}",
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ]
        },
        {
          "name": "Logout",
          "method": "POST",
          "url": "{{baseUrl}}/api/auth/logout",
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "Invalida la sesión incrementando tokenVersion."
        }
      ]
    },
    {
      "name": "03 Productos (público)",
      "item": [
        {
          "name": "Listado con filtros",
          "method": "GET",
          "url": "{{baseUrl}}/api/products",
          "description": "page, limit, categoria, marca, search, minPrice, maxPrice, enPromocion, destacado, sort."
        },
        {
          "name": "Detalle por id",
          "method": "GET",
          "url": "{{baseUrl}}/api/products/{{id}}",
          "description": "404 si el producto está inactivo."
        },
        {
          "name": "Destacados",
          "method": "GET",
          "url": "{{baseUrl}}/api/products/featured"
