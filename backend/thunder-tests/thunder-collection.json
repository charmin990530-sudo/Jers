          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "Sin sesión. Si viene el campo trampa website, responde 202 sin guardar."
        }
      ]
    },
