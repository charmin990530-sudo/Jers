          "url": "{{baseUrl}}/api/products/categoria/{{slug}}"
        },
        {
          "name": "Buscar",
          "method": "GET",
          "url": "{{baseUrl}}/api/products/buscar",
          "description": "Mínimo 2 caracteres."
        }
      ]
    },
    {
      "name": "04 Carrito",
      "item": [
        {
          "name": "Ver carrito",
          "method": "GET",
          "url": "{{baseUrl}}/api/cart"
        },
        {
          "name": "Agregar producto",
          "method": "POST",
          "url": "{{baseUrl}}/api/cart",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"productoId\": \"6aba1d040f6091d754035656\",\n  \"cantidad\": 2\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "headers": [
            {
              "key": "X-CSRF-Token",
              "value": "{{csrfToken}}",
              "description": "Token de /api/auth/csrf"
            }
          ],
          "description": "Guarda el _id del item en {{itemId}}."
        },
        {
          "name": "Cambiar cantidad",
          "method": "PATCH",
          "url": "{{baseUrl}}/api/cart/{{itemId}}",
          "body": {
            "mode": "raw",
