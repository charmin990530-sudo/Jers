{
  "name": "by-jers-store",
  "version": "1.0.0",
  "description": "By Jers - tienda de maquillaje y cuidado capilar (frontend + API en un solo proceso)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "build:static": "node scripts/preparar-estatico.mjs",
    "prestart": "npm run build:static",
    "start": "node backend/src/app.js",
    "predev": "npm run build:static",
    "dev": "node --watch backend/src/app.js",
    "seed": "node backend/src/seeds/seed.js",
    "test": "npm test --prefix backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "autostart": "node scripts/instalar-autoinicio.mjs",
    "autostart:stop": "node scripts/instalar-autoinicio.mjs --desinstalar",
    "autostart:status": "node scripts/instalar-autoinicio.mjs --estado"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  }
}
