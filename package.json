{
  "name": "by-jers-store",
  "version": "1.0.0",
  "description": "By Jers - tienda de maquillaje y cuidado capilar (frontend + API en un solo proceso)",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "build:demo": "node scripts/preparar-demo.mjs",
    "build:static": "node scripts/preparar-estatico.mjs",
    "prestart": "npm run build:static",
    "start": "node backend/src/app.js",
    "predev": "npm run build:static",
    "dev": "node --watch backend/src/app.js",
    "seed": "node backend/src/seeds/seed.js",
    "test": "npm run test:backend && npm run test:angular",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --prefix frontend/angular",
    "check": "npm run lint && npm run typecheck",
    "autostart": "node scripts/instalar-autoinicio.mjs",
    "autostart:stop": "node scripts/instalar-autoinicio.mjs --desinstalar",
    "autostart:status": "node scripts/instalar-autoinicio.mjs --estado",
    "test:backend": "npm test --prefix backend --",
    "dev:frontend": "npm start --prefix frontend/angular",
    "check:angular": "npm run typecheck --prefix frontend/angular",
    "preview:gpu": "node scripts/abrir-con-gpu.mjs",
    "test:angular": "node scripts/run-tests-angular.mjs",
    "admin:create": "node scripts/crear-admin.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^15.15.0"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.8"
  }
}
