# Servicio systemd de usuario para levantar By Jers en local.
#
# Se instala (NO se versiona el symlink) con:
#   node scripts/instalar-autoinicio.mjs
#
# StartUnit: se arranca al iniciar sesion y se reinicia solo si el proceso
# muere (caida de Mongo, error de arranque, Ctrl-C accidental).
# WantedBy:  default.target, ademas de graphical-session.target para que
#            arranque tambien con la sesion grafica.
#
# Se detiene con:  systemctl --user stop by-jers-dev
# Se ve el estado: systemctl --user status by-jers-dev
# Se ven los logs: journalctl --user -u by-jers-dev -f

[Unit]
Description=By Jers - tienda (Express: sitio estatico + API)
Documentation=file://%h/.config/systemd/user/by-jers-dev.service
After=network-online.target mongod.service
Wants=network-online.target
# MongoDB local es un servicio del sistema. Si esta apagado, By Jers arranca
# igual: la API responde 503 DATABASE_UNAVAILABLE y reintenta en cada peticion,
# de modo que no hace falta que el backend espere a la base.
After=mongod.service
Wants=mongod.service

# Desde systemd 230 estas dos van en [Unit], no en [Service]: ponerlas en
# [Service] hace que systemd rechace el fichero entero con
# "bad unit file setting" y el servicio no arranca nunca.
# Si Mongo esta caido el proceso NO se cae (arranca y degrada a 503), asi que
# este limite solo atrapa bucles de fallo por configuracion invalida.
StartLimitBurst=10
StartLimitIntervalSec=120

[Service]
Type=simple
# Se regenera public/ antes de arrancar, igual que `npm start`. Asi lo
# servido nunca queda desfasado del fuente.
ExecStartPre=/usr/bin/env npm run build:static
ExecStart=/usr/bin/env npm start
WorkingDirectory=REPLACE_WITH_PROJECT_PATH

Restart=always
RestartSec=3

Environment=NODE_ENV=development
# Los logs van al journal del usuario, no a ficheros que crezcan sin rotar.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=by-jers-dev

[Install]
WantedBy=default.target graphical-session.target